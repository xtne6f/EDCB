<Window x:Class="EpgTimer.EpgDataViewSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:EpgTimer"
        Height="{StaticResource AppEpgDataViewSettingWindowHeight}" SizeToContent="Width" Style="{StaticResource AppWindowStyle}" Title="EPGデータ表示設定" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="{StaticResource AppEdgeMargin}" Orientation="Horizontal">
            <Button Content="OK" Style="{StaticResource AppConfirmButtonStyle}" Click="button_OK_Click" />
            <Button Content="キャンセル" IsCancel="True" Margin="{StaticResource AppConfirmMargin}" Style="{StaticResource AppConfirmButtonStyle}" />
        </StackPanel>
        <my:EpgDataViewSetting x:Name="epgDataViewSetting" />
    </DockPanel>
</Window>
