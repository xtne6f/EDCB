<UserControl x:Class="EpgTimer.EpgDataViewSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EpgTimer">
    <UserControl.Resources>
        <local:ToStringValueIsNotEqualConverter x:Key="notEqualConvert" />
    </UserControl.Resources>
    <TabControl>
        <TabItem Header="表示設定">
            <Grid Margin="{StaticResource AppEdgeMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <RadioButton Content="標準モード" HorizontalAlignment="Left" IsChecked="True" Name="radioButton_rate" Style="{StaticResource AppRadioButtonStyle}" />
                    <StackPanel Margin="{StaticResource AppIndentMargin}">
                        <CheckBox Content="番組のない時間帯は表示しない" HorizontalAlignment="Left" Margin="{StaticResource AppMarginT}" Name="checkBox_noTimeView_rate" Style="{StaticResource AppCheckBoxStyle}" />
                    </StackPanel>
                    <RadioButton Content="1週間モード" HorizontalAlignment="Left" IsChecked="False" Margin="{StaticResource AppMarginT}" Name="radioButton_week" Style="{StaticResource AppRadioButtonStyle}" />
                    <StackPanel Margin="{StaticResource AppIndentMargin}">
                        <CheckBox Content="番組のない時間帯は表示しない" HorizontalAlignment="Left" Margin="{StaticResource AppMarginT}" Name="checkBox_noTimeView_week" Style="{StaticResource AppCheckBoxStyle}" />
                        <StackPanel Margin="{StaticResource AppMarginT}" Orientation="Horizontal">
                            <Label Content="表示開始時間" Style="{StaticResource AppTermLabelStyle}" />
                            <ComboBox Name="comboBox_timeH_week" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_timeH_week_ref}" />
                            <ComboBox Name="comboBox_timeH_week_ref" SelectedIndex="0" Style="{StaticResource AppComboBoxStyle}" Visibility="Hidden">
                                <ComboBoxItem Content="88" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <RadioButton Content="リスト表示モード" HorizontalAlignment="Left" IsChecked="False" Margin="{StaticResource AppMarginT}" Name="radioButton_list" Style="{StaticResource AppRadioButtonStyle}" />
                    <StackPanel Margin="{StaticResource AppIndentMargin}">
                        <CheckBox Content="終了済みの番組は表示しない" HorizontalAlignment="Left" Margin="{StaticResource AppMarginT}" Name="checkBox_filterEnded" Style="{StaticResource AppCheckBoxStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="{StaticResource AppIndentMargin}">
                    <DockPanel>
                        <Label Content="タブ名" DockPanel.Dock="Left" Style="{StaticResource AppTermLabelStyle}" />
                        <TextBox Name="textBox_tabName" Style="{StaticResource AppTextBoxStyle}" Text="NewTab" />
                    </DockPanel>
                    <Label Content="デザイン" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppLabelStyle}" />
                    <StackPanel Margin="{StaticResource AppMarginT}" Orientation="Horizontal">
                        <RadioButton Content="デフォルト" IsChecked="True" Margin="{StaticResource AppIndentMargin}" Name="radioButton_designDefault" Style="{StaticResource AppRadioButtonStyle}" />
                        <RadioButton Content="サブ1" Margin="{StaticResource AppWideMarginL}" Name="radioButton_designSub1" Style="{StaticResource AppRadioButtonStyle}" />
                        <RadioButton Content="サブ2" Margin="{StaticResource AppWideMarginL}" Name="radioButton_designSub2" Style="{StaticResource AppRadioButtonStyle}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.ColumnSpan="2" Grid.Row="1" Margin="{StaticResource AppWideMarginT}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Label Content="表示ジャンル (項目なしで全ジャンル)" Grid.ColumnSpan="3" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" />
                    <ListBox Grid.Row="1" HorizontalAlignment="Left" Name="listBox_jyanruView_ref" ScrollViewer.VerticalScrollBarVisibility="Visible" Visibility="Hidden" />
                    <ListBox DisplayMemberPath="ListBoxView" Grid.Row="1" Name="listBox_jyanruView" Width="{Binding ActualWidth, ElementName=listBox_jyanruView_ref}" />
                    <Label Content="ジャンル一覧" Grid.Column="2" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" />
                    <ListBox Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" Name="listBox_jyanru_ref" ScrollViewer.VerticalScrollBarVisibility="Visible" Visibility="Hidden" />
                    <ListBox Grid.Column="2" Grid.Row="1" Name="listBox_jyanru" Width="{Binding ActualWidth, ElementName=listBox_jyanru_ref}" />
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="{StaticResource AppMarginLR}">
                        <Button Content="全追加" Style="{StaticResource AppButtonStyle}" Click="button_jyanru_addAll_Click" />
                        <Button Content="追加" IsEnabled="{Binding SelectedIndex, ElementName=listBox_jyanru, Converter={StaticResource notEqualConvert}, ConverterParameter=-1}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_jyanru_add_Click" />
                        <Button Content="削除" IsEnabled="{Binding SelectedIndex, ElementName=listBox_jyanruView, Converter={StaticResource notEqualConvert}, ConverterParameter=-1}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_jyanru_del_Click" />
                        <Button Content="全削除" IsEnabled="{Binding Items.Count, ElementName=listBox_jyanruView, Converter={StaticResource notEqualConvert}, ConverterParameter=0}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_jyanru_delAll_Click" />
                    </StackPanel>
                </Grid>
                <CheckBox Content="表示ジャンルの番組を強調表示する (表示ジャンル以外を薄くする)" Grid.ColumnSpan="2" Grid.Row="2" HorizontalAlignment="Left" IsChecked="True" Margin="{StaticResource AppMarginT}" Name="checkBox_highlightContentKind" Style="{StaticResource AppCheckBoxStyle}" />
            </Grid>
        </TabItem>
        <TabItem Header="表示条件">
            <Grid Margin="{StaticResource AppEdgeMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="3" Margin="{StaticResource AppMarginB}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="検索による絞り込みを行う" Name="checkBox_searchMode" Style="{StaticResource AppCheckBoxStyle}" />
                        <Button Content="検索条件" IsEnabled="{Binding IsChecked, ElementName=checkBox_searchMode}" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppButtonStyle}" Click="button_searchKey_Click" />
                    </StackPanel>
                    <StackPanel Margin="{StaticResource AppIndentMargin}">
                        <Label Content="(表示サービスは並び順のために設定が必要です。)" IsEnabled="{Binding IsChecked, ElementName=checkBox_searchMode}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppLabelStyle}" />
                    </StackPanel>
                </StackPanel>
                <Label Content="表示サービス (同一TSでSIDを逆順にすると結合)" Grid.ColumnSpan="2" Grid.Row="1" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" />
                <ListBox DisplayMemberPath="Item1" Grid.Row="2" Name="listBox_serviceView" SelectionChanged="listBox_or_tabControl_service_SelectionChanged" />
                <Label Content="サービス一覧" Grid.Column="2" Grid.Row="1" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" />
                <TabControl Grid.Column="2" Grid.Row="2" SelectionChanged="listBox_or_tabControl_service_SelectionChanged">
                    <TabItem Header="地デジ" Name="tabItem_tere">
                        <ListBox DisplayMemberPath="Item1" Name="listBox_serviceTere" SelectionChanged="listBox_or_tabControl_service_SelectionChanged" />
                    </TabItem>
                    <TabItem Header="BS" Name="tabItem_bs">
                        <ListBox DisplayMemberPath="Item1" Name="listBox_serviceBS" SelectionChanged="listBox_or_tabControl_service_SelectionChanged" />
                    </TabItem>
                    <TabItem Header="CS" Name="tabItem_cs">
                        <ListBox DisplayMemberPath="Item1" Name="listBox_serviceCS" SelectionChanged="listBox_or_tabControl_service_SelectionChanged" />
                    </TabItem>
                    <TabItem Header="CS3" Name="tabItem_cs3">
                        <ListBox DisplayMemberPath="Item1" Name="listBox_serviceCS3" SelectionChanged="listBox_or_tabControl_service_SelectionChanged" />
                    </TabItem>
                    <TabItem Header="その他" Name="tabItem_other">
                        <ListBox DisplayMemberPath="Item1" Name="listBox_serviceOther" SelectionChanged="listBox_or_tabControl_service_SelectionChanged" />
                    </TabItem>
                </TabControl>
                <TextBox Grid.Row="3" IsReadOnly="True" Margin="{StaticResource AppMarginT}" Name="textBox_serviceView_ref" Style="{StaticResource AppMultiLineTextBoxStyle}" Text="Aあ&#10;Aあ&#10;Aあ&#10;Aあ&#10;Aあ&#10;Aあ" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="Hidden" />
                <TextBox Grid.Row="3" Height="{Binding ActualHeight, ElementName=textBox_serviceView_ref}" IsReadOnly="True" Margin="{StaticResource AppMarginT}" Name="textBox_serviceView1" Style="{StaticResource AppMultiLineTextBoxStyle}" TextWrapping="Wrap" />
                <TextBox Grid.Column="2" Grid.Row="3" Height="{Binding ActualHeight, ElementName=textBox_serviceView_ref}" IsReadOnly="True" Margin="{StaticResource AppMarginT}" Name="textBox_serviceView2" Style="{StaticResource AppMultiLineTextBoxStyle}" TextWrapping="Wrap" />
                <Grid Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" Margin="{StaticResource AppMarginLR}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Content="全追加" Style="{StaticResource AppButtonStyle}" Click="button_service_addAll_Click" />
                    <Button Content="映像のみ追加" Grid.ColumnSpan="2" Grid.Row="1" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_service_addVideo_Click" />
                    <Button Content="追加" Grid.Row="2" IsEnabled="{Binding Text, ElementName=textBox_serviceView2, Converter={StaticResource notEqualConvert}, ConverterParameter=''}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_service_add_Click" />
                    <Button Content="削除" Grid.Row="3" IsEnabled="{Binding SelectedIndex, ElementName=listBox_serviceView, Converter={StaticResource notEqualConvert}, ConverterParameter=-1}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_service_del_Click" />
                    <Button Content="全削除" Grid.Row="4" IsEnabled="{Binding Items.Count, ElementName=listBox_serviceView, Converter={StaticResource notEqualConvert}, ConverterParameter=0}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_service_delAll_Click" />
                    <Button Content="↑" Grid.Row="5" IsEnabled="{Binding SelectedIndex, ElementName=listBox_serviceView, Converter={StaticResource notEqualConvert}, ConverterParameter=-1}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_service_up_Click" />
                    <Button Content="↓" Grid.Row="6" IsEnabled="{Binding SelectedIndex, ElementName=listBox_serviceView, Converter={StaticResource notEqualConvert}, ConverterParameter=-1}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_service_down_Click" />
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
