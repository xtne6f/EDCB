<UserControl x:Class="EpgTimer.SearchKeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <DockPanel Margin="{StaticResource AppEdgeMarginLTR}">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Name="columnDefinition_notKey" Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Name="columnDefinition_note" Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="検索キーワード" Style="{StaticResource AppTermLabelStyle}" ToolTip="【検索対象を指定】 :title:ネコ&#10;   :title:番組名&#10;   :event:番組名と番組内容&#10;   :genre:ジャンル&#10;   :video:映像情報&#10;   :audio:音声情報&#10;【個別に正規表現】 ::title:^ネコ&#10;【OR検索】 :title:ネコ | :title:猫" />
            <Label Content="NOTキーワード" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" ToolTip="【検索対象を指定】 :title:ネコ&#10;   :title:番組名&#10;   :event:番組名と番組内容&#10;   :genre:ジャンル&#10;   :video:映像情報&#10;   :audio:音声情報&#10;【個別に正規表現】 ::title:^ネコ" />
            <ComboBox Grid.Column="1" Grid.ColumnSpan="3" Height="{Binding ActualHeight, ElementName=textBox_note}" IsEditable="True" IsTextSearchEnabled="False" KeyUp="comboBox_andKey_KeyUp" Name="comboBox_andKey" Style="{StaticResource AppComboBoxStyle}" />
            <FrameworkElement Grid.Row="1" Margin="{StaticResource AppMarginT}" />
            <ComboBox Grid.Column="1" Grid.Row="2" IsEditable="True" IsTextSearchEnabled="False" Name="comboBox_notKey" Style="{StaticResource AppComboBoxStyle}" KeyUp="comboBox_notKey_KeyUp" SizeChanged="comboBox_notKey_SizeChanged" />
            <FrameworkElement Grid.Column="2" Grid.Row="2" Margin="{StaticResource AppMarginL}" />
            <GridSplitter Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" />
            <DockPanel Grid.Column="3"  Grid.Row="2">
                <Label Content="メモ" Style="{StaticResource AppLabelStyle}" />
                <TextBox Margin="{StaticResource AppMarginL}" Name="textBox_note" Style="{StaticResource AppTextBoxStyle}" />
            </DockPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Top" Margin="{StaticResource AppIndentMargin}" Orientation="Horizontal">
            <Border Margin="{StaticResource AppMarginT}" Style="{StaticResource AppSearchOptionsBorderStyle}">
                <StackPanel KeyboardNavigation.TabNavigation="Once" Orientation="Horizontal">
                    <CheckBox Content="正規表現モード" Name="checkBox_regExp" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="あいまい検索モード" Margin="{StaticResource AppWideMarginL}" Name="checkBox_aimai" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="番組名のみ検索対象にする" Margin="{StaticResource AppWideMarginL}" Name="checkBox_titleOnly" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="大小文字区別" Margin="{StaticResource AppWideMarginL}" Name="checkBox_case" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="自動登録を無効にする" Margin="{StaticResource AppWideMarginL}" Name="checkBox_keyDisabled" Style="{StaticResource AppCheckBoxStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Margin="{StaticResource AppMarginT}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="{StaticResource AppEdgeMarginB}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="ジャンル絞り込み" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox Grid.RowSpan="2" HorizontalAlignment="Left" Name="listBox_content_ref" ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionMode="Extended" Visibility="Hidden" />
                    <ListBox DisplayMemberPath="ListBoxView" Grid.RowSpan="2" Name="listBox_content" SelectionMode="Extended" Width="{Binding ActualWidth, ElementName=listBox_content_ref}" />
                    <CheckBox Content="NOT扱い" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="{StaticResource AppMarginL}" Name="checkBox_notContent" Style="{StaticResource AppCheckBoxStyle}" VerticalAlignment="Bottom" />
                    <Button Content="削除" Grid.Column="1" Grid.Row="1" Margin="{StaticResource AppMarginLT}" Style="{StaticResource AppButtonStyle}" Click="button_content_del_Click" />
                    <FrameworkElement Grid.Row="2" Margin="{StaticResource AppMarginT}" />
                    <ComboBox Grid.Row="3" Name="comboBox_content" Style="{StaticResource AppComboBoxStyle}" />
                    <Button Content="追加" Grid.Column="1" Grid.Row="3" Margin="{StaticResource AppMarginL}" Name="button_content_add" Style="{StaticResource AppButtonStyle}" Click="button_content_add_Click" />
                    <Popup Name="popup_content_add" PlacementTarget="{Binding ElementName=button_content_add}" StaysOpen="False" Style="{StaticResource AppErrorMessagePopupStyle}">
                        <ContentControl Template="{StaticResource AppErrorMessagePopupTemplate}" />
                    </Popup>
                </Grid>
                <Label Content="時間絞り込み" Grid.Row="2" Margin="{StaticResource AppMarginTB}" Style="{StaticResource AppLabelStyle}" />
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox Grid.RowSpan="2" HorizontalAlignment="Left" Name="listBox_date_ref" ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionMode="Extended" Visibility="Hidden" />
                    <ListBox DisplayMemberPath="Item1" Grid.RowSpan="2" Name="listBox_date" SelectionMode="Extended" Width="{Binding ActualWidth, ElementName=listBox_date_ref}" />
                    <CheckBox Content="NOT扱い" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="{StaticResource AppMarginL}" Name="checkBox_notDate" Style="{StaticResource AppCheckBoxStyle}" VerticalAlignment="Bottom" />
                    <Button Content="削除" Grid.Column="1" Grid.Row="1" Margin="{StaticResource AppMarginLT}" Style="{StaticResource AppButtonStyle}" Click="button_date_del_Click" />
                    <StackPanel Grid.ColumnSpan="3" Grid.Row="2" Margin="{StaticResource AppMarginLT}" Orientation="Horizontal">
                        <RadioButton Content="曜日毎" Name="radioButton_week" Style="{StaticResource AppRadioButtonStyle}" Checked="radioButton_week_Checked" />
                        <RadioButton Content="期間" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppRadioButtonStyle}" Checked="radioButton_time_Checked" />
                    </StackPanel>
                </Grid>
                <ComboBox Grid.Row="4" HorizontalAlignment="Left" Name="comboBox_hms_ref" SelectedIndex="0" Style="{StaticResource AppComboBoxStyle}" Visibility="Hidden">
                    <ComboBoxItem Content="88" />
                </ComboBox>
                <StackPanel Grid.Row="4" Margin="{StaticResource AppMarginLT}" Orientation="Horizontal">
                    <ComboBox Name="comboBox_time_sw" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                    <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_time_sh" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                    <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_time_sm" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                </StackPanel>
                <StackPanel Grid.Row="4" KeyboardNavigation.TabNavigation="Once" Margin="{StaticResource AppMarginLT}" Orientation="Horizontal">
                    <CheckBox Content="日" Name="checkBox_sun" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="月" Margin="{StaticResource AppMarginL}" Name="checkBox_mon" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="火" Margin="{StaticResource AppMarginL}" Name="checkBox_tue" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="水" Margin="{StaticResource AppMarginL}" Name="checkBox_wed" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="木" Margin="{StaticResource AppMarginL}" Name="checkBox_thu" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="金" Margin="{StaticResource AppMarginL}" Name="checkBox_fri" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="土" Margin="{StaticResource AppMarginL}" Name="checkBox_sat" Style="{StaticResource AppCheckBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="5" Margin="{StaticResource AppMarginLT}" Orientation="Horizontal">
                    <ComboBox Name="comboBox_week_sh" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                    <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_week_sm" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                    <Label Content="～" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppLabelStyle}" />
                    <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_time_ew" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                    <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_time_eh" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                    <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_time_em" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                    <Button Content="追加" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppButtonStyle}" Click="button_date_add_Click" />
                </StackPanel>
            </Grid>
            <FrameworkElement Grid.Column="1" Margin="{StaticResource AppIndentMargin}" />
            <Grid Grid.Column="2" Margin="{StaticResource AppEdgeMarginB}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="サービス絞り込み" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" />
                <ListView Name="listView_service" Grid.Row="1" Grid.ColumnSpan="2" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn>
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Path=IsSelected}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=NetworkName}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="ネットワーク" HorizontalContentAlignment="Left" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=ServiceName}" Width="{StaticResource AppSearchServiceNameColumnWidth}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="サービス名" HorizontalContentAlignment="Left" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="2" Margin="{StaticResource AppWideMarginT}" Orientation="Horizontal">
                    <Label Content="スクランブル放送" Style="{StaticResource AppTermLabelStyle}" />
                    <ComboBox Name="comboBox_free" SelectedIndex="0" Style="{StaticResource AppComboBoxStyle}">
                        <ComboBoxItem Content="無料、有料番組を対象とする" />
                        <ComboBoxItem Content="無料番組のみ対象とする" />
                        <ComboBoxItem Content="有料番組のみ対象とする" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="{StaticResource AppMarginT}" Orientation="Horizontal">
                    <Label Content="番組長" Style="{StaticResource AppTermLabelStyle}" />
                    <TextBox InputMethod.IsInputMethodEnabled="False" Name="textBox_chkDurationMin" Style="{StaticResource AppNarrowTextBoxStyle}" Text="0" />
                    <Label Content="分以上" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppLabelStyle}" />
                    <TextBox InputMethod.IsInputMethodEnabled="False" Margin="{StaticResource AppMarginL}" Name="textBox_chkDurationMax" Style="{StaticResource AppNarrowTextBoxStyle}" Text="0" />
                    <Label Content="分以下(0で無制限)" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppLabelStyle}" />
                </StackPanel>
                <GroupBox Grid.Row="4" Header="自動予約登録専用" Margin="{StaticResource AppMarginT}">
                    <StackPanel Margin="{StaticResource AppMargin}">
                        <CheckBox Content="同一番組名の録画結果があれば無効で登録する" HorizontalAlignment="Left" Name="checkBox_chkRecEnd" Style="{StaticResource AppCheckBoxStyle}" />
                        <StackPanel Margin="{StaticResource AppIndentMargin}">
                            <StackPanel Margin="{StaticResource AppMarginT}" Orientation="Horizontal">
                                <Label Content="確認対象期間" Style="{StaticResource AppTermLabelStyle}" />
                                <TextBox InputMethod.IsInputMethodEnabled="False" IsEnabled="{Binding IsChecked, ElementName=checkBox_chkRecEnd, UpdateSourceTrigger=PropertyChanged}" Name="textBox_chkRecDay" Style="{StaticResource AppNarrowTextBoxStyle}" Text="0" />
                                <Label Content="日前まで" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppLabelStyle}" />
                            </StackPanel>
                            <CheckBox Content="全てのサービスで無効にする" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=checkBox_chkRecEnd, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource AppMarginT}" Name="checkBox_chkRecNoService" Style="{StaticResource AppCheckBoxStyle}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <StackPanel Grid.Column="2" Grid.Row="1" Grid.RowSpan="5" Margin="{StaticResource AppMarginL}">
                    <Button Content="全チェック" Style="{StaticResource AppButtonStyle}" Click="button_all_on_Click" />
                    <Button Content="映像のみ" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_video_on_Click" />
                    <Button Content="クリア" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_all_off_Click" />
                    <Button Content="+地デジ映像" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_dttv_on_Click" />
                    <Button Content="+BS映像" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_bs_on_Click" />
                    <Button Content="+CS映像" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_cs_on_Click" />
                    <Button Content="+CS3映像" Margin="{StaticResource AppMarginT}" Name="button_cs3" Style="{StaticResource AppButtonStyle}" Visibility="Hidden" Click="button_cs3_on_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
