<Window x:Class="EpgTimer.AddPresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FocusManager.FocusedElement="{Binding ElementName=textBox_name}" SizeToContent="Height" Style="{StaticResource AppWindowStyle}" Title="プリセット名" Width="{StaticResource AppAddPresetWindowWidth}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="{StaticResource AppEdgeMargin}">
        <DockPanel>
            <Label Content="プリセット名" Style="{StaticResource AppTermLabelStyle}" />
            <TextBox Name="textBox_name" Style="{StaticResource AppTextBoxStyle}" />
        </DockPanel>
        <StackPanel HorizontalAlignment="Right" Margin="{StaticResource AppEdgeMarginT}" Orientation="Horizontal">
            <Label Content="(※設定内容も同時に変更されます)" Name="label_chgMsg" Style="{StaticResource AppLabelStyle}" Visibility="Collapsed" />
            <Button Content="変更" Margin="{StaticResource AppConfirmMargin}" Name="button_chg" Style="{StaticResource AppConfirmButtonStyle}" Visibility="Collapsed" Click="button_ok_Click" />
            <Button Content="追加" Name="button_add" Style="{StaticResource AppConfirmButtonStyle}" Click="button_ok_Click" />
            <Button Content="キャンセル" IsCancel="True" Margin="{StaticResource AppConfirmMargin}" Name="button_cancel" Style="{StaticResource AppConfirmButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
