<Window x:Class="EpgTimer.SuspendCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Style="{StaticResource AppWindowStyle}" Title="確認" Topmost="True" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="Window_Loaded">
    <StackPanel Margin="{StaticResource AppEdgeMargin}">
        <Label Content="スタンバイ、または休止に移行します。" HorizontalContentAlignment="Center" Name="label_mode0" Style="{StaticResource AppLabelStyle}" />
        <Label Content="スタンバイに移行します。" HorizontalContentAlignment="Center" Name="label_mode1" Style="{StaticResource AppLabelStyle}" Visibility="Collapsed" />
        <Label Content="休止に移行します。" HorizontalContentAlignment="Center" Name="label_mode2" Style="{StaticResource AppLabelStyle}" Visibility="Collapsed" />
        <Label Content="シャットダウンします。" HorizontalContentAlignment="Center" Name="label_mode3" Style="{StaticResource AppLabelStyle}" Visibility="Collapsed" />
        <Label Content="再起動します。" HorizontalContentAlignment="Center" Name="label_reboot" Style="{StaticResource AppLabelStyle}" Visibility="Collapsed" />
        <ProgressBar Maximum="20" Name="progressBar" Style="{StaticResource AppSuspendCheckProgressBarStyle}" Value="20" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="即実行" Style="{StaticResource AppConfirmButtonStyle}" Visibility="Hidden" />
            <Button Content="キャンセル" Grid.Column="2" IsCancel="True" IsDefault="True" Style="{StaticResource AppSuspendCheckButtonStyle}" />
            <Button Content="即実行" Grid.Column="4" Style="{StaticResource AppSuspendCheckButtonStyle}" Click="button_ok_Click" />
        </Grid>
    </StackPanel>
</Window>
