<Window x:Class="EpgTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EpgTimer"
        AllowDrop="True" Height="{StaticResource AppMainWindowHeight}" Style="{StaticResource AppWindowStyle}" Title="EpgTimer" Width="{StaticResource AppMainWindowWidth}" Closing="Window_Closing" Loaded="Window_Loaded" PreviewDragEnter="Window_PreviewDragEnter" PreviewDrop="Window_PreviewDrop" PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged">
    <Grid Name="grid_main">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Name="stackPanel_button" Orientation="Horizontal">
            <Button Content="設定" Style="{StaticResource AppMainWindowButtonStyle}" Visibility="Collapsed" Click="settingButton_Click" />
            <Button Content="検索" Style="{StaticResource AppMainWindowButtonStyle}" Visibility="Collapsed" Click="searchButton_Click" />
            <Button Content="終了" Style="{StaticResource AppMainWindowButtonStyle}" Visibility="Collapsed" Click="closeButton_Click" />
            <Button Content="スタンバイ" Style="{StaticResource AppMainWindowButtonStyle}" Visibility="Collapsed" Click="standbyButton_Click" />
            <Button Content="休止" Style="{StaticResource AppMainWindowButtonStyle}" Visibility="Collapsed" Click="suspendButton_Click" />
            <Button Content="EPG取得" Style="{StaticResource AppMainWindowButtonStyle}" Visibility="Collapsed" Click="epgCapButton_Click" />
            <Button Content="EPG再読み込み" Style="{StaticResource AppMainWindowButtonStyle}" Visibility="Collapsed" Click="epgReloadButton_Click" />
            <Button Style="{StaticResource AppMainWindowButtonStyle}" Tag="カスタム１" Visibility="Collapsed" Click="custum1Button_Click" />
            <Button Style="{StaticResource AppMainWindowButtonStyle}" Tag="カスタム２" Visibility="Collapsed" Click="custum2Button_Click" />
            <Button Content="NetworkTV終了" Style="{StaticResource AppMainWindowButtonStyle}" Visibility="Collapsed" Click="nwTVEndButton_Click" />
            <Button Content="情報通知ログ" Style="{StaticResource AppMainWindowButtonStyle}" Visibility="Collapsed" Click="logViewButton_Click" />
            <Button Content="再接続" Style="{StaticResource AppMainWindowButtonStyle}" Visibility="Collapsed" Click="connectButton_Click" />
        </StackPanel>
        <TabControl Name="tabControl_main" Grid.Row="1">
            <TabItem Header="予約一覧" Name="tabItem_reserve">
                <local:ReserveView x:Name="reserveView" />
            </TabItem>
            <TabItem Header="使用予定チューナー" Name="tabItem_tunerReserve">
                <local:TunerReserveMainView x:Name="tunerReserveView" />
            </TabItem>
            <TabItem Header="録画済み一覧" Name="tabItem_recinfo">
                <local:RecInfoView x:Name="recInfoView" />
            </TabItem>
            <TabItem Header="自動予約登録" Name="tabItem_epgAutoAdd">
                <local:AutoAddView x:Name="autoAddView" />
            </TabItem>
            <TabItem Header="番組表" Name="tabItem_epg">
                <local:EpgDataView x:Name="epgView" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
