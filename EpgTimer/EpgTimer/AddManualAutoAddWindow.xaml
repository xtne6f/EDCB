<Window x:Class="EpgTimer.AddManualAutoAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:EpgTimer"
        SizeToContent="Height" Style="{StaticResource AppWindowStyle}" Title="プログラム予約条件" Width="{StaticResource AppRecSettingWindowWidth}" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="{StaticResource AppEdgeMarginLTR}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="録画曜日" Style="{StaticResource AppTermLabelStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox Content="日" Name="checkBox_week0" Style="{StaticResource AppCheckBoxStyle}" />
                <CheckBox Content="月" Margin="{StaticResource AppWideMarginL}" Name="checkBox_week1" Style="{StaticResource AppCheckBoxStyle}" />
                <CheckBox Content="火" Margin="{StaticResource AppWideMarginL}" Name="checkBox_week2" Style="{StaticResource AppCheckBoxStyle}" />
                <CheckBox Content="水" Margin="{StaticResource AppWideMarginL}" Name="checkBox_week3" Style="{StaticResource AppCheckBoxStyle}" />
                <CheckBox Content="木" Margin="{StaticResource AppWideMarginL}" Name="checkBox_week4" Style="{StaticResource AppCheckBoxStyle}" />
                <CheckBox Content="金" Margin="{StaticResource AppWideMarginL}" Name="checkBox_week5" Style="{StaticResource AppCheckBoxStyle}" />
                <CheckBox Content="土" Margin="{StaticResource AppWideMarginL}" Name="checkBox_week6" Style="{StaticResource AppCheckBoxStyle}" />
            </StackPanel>
            <FrameworkElement Grid.Row="1" Margin="{StaticResource AppMarginT}" />
            <Label Content="録画時間" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
            <ComboBox Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" Name="comboBox_hms_ref" SelectedIndex="0" Style="{StaticResource AppComboBoxStyle}" Visibility="Hidden">
                <ComboBoxItem Content="88" />
            </ComboBox>
            <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
                <ComboBox Name="comboBox_startHH" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                <Label Content="：" Style="{StaticResource AppLabelStyle}" />
                <ComboBox Name="comboBox_startMM" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                <Label Content="：" Style="{StaticResource AppLabelStyle}" />
                <ComboBox Name="comboBox_startSS" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                <Label Content="～" Margin="{StaticResource AppWideMarginLR}" Style="{StaticResource AppLabelStyle}" />
                <ComboBox Name="comboBox_endHH" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                <Label Content="：" Style="{StaticResource AppLabelStyle}" />
                <ComboBox Name="comboBox_endMM" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                <Label Content="：" Style="{StaticResource AppLabelStyle}" />
                <ComboBox Name="comboBox_endSS" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
            </StackPanel>
            <FrameworkElement Grid.Row="3" Margin="{StaticResource AppMarginT}" />
            <Label Content="番組名" Grid.Row="4" Style="{StaticResource AppTermLabelStyle}" />
            <TextBox Grid.Column="1" Grid.Row="4" Name="textBox_title" Style="{StaticResource AppTextBoxStyle}" />
            <FrameworkElement Grid.Row="5" Margin="{StaticResource AppMarginT}" />
            <Label Content="サービス" Grid.Row="6" Style="{StaticResource AppTermLabelStyle}" />
            <Grid Grid.Column="1" Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Name="comboBox_service" Style="{StaticResource AppComboBoxStyle}" />
            </Grid>
        </Grid>
        <my:RecSettingView Grid.Row="1" Margin="{StaticResource AppWideMarginT}" x:Name="recSettingView" />
        <StackPanel Grid.Row="2" Margin="{StaticResource AppEdgeMargin}" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="追加" Name="button_add" Style="{StaticResource AppConfirmButtonStyle}" ToolTip="Ctrl + S" Click="button_add_Click" />
            <Button Content="キャンセル" Margin="{StaticResource AppConfirmMargin}" Style="{StaticResource AppConfirmButtonStyle}" Click="button_cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
