<Window x:Class="EpgTimer.Setting.SetDefRecSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:EpgTimer"
        SizeToContent="Height" Style="{StaticResource AppWindowStyle}" Title="デフォルト録画設定" Width="{StaticResource AppRecSettingWindowWidth}" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Content="※変更を行うにはプリセットごとに変更ボタンを押してください" Margin="{StaticResource AppEdgeMarginLTR}" Style="{StaticResource AppLabelStyle}" />
        <my:RecSettingView Grid.Row="1" Margin="{StaticResource AppWideMarginT}" x:Name="recSettingView" />
        <Button Content="閉じる" Grid.Row="2" HorizontalAlignment="Right" IsCancel="True" Margin="{StaticResource AppEdgeMargin}" Style="{StaticResource AppConfirmButtonStyle}" />
    </Grid>
</Window>
