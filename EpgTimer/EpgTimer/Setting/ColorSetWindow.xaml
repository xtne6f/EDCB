<Window x:Class="EpgTimer.ColorSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Style="{StaticResource AppWindowStyle}" Title="色指定" Width="{StaticResource AppColorSetWindowWidth}" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <StackPanel Margin="{StaticResource AppEdgeMargin}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="R" Style="{StaticResource AppTermLabelStyle}" />
            <TextBox Grid.Column="1" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding R, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
            <Slider Grid.Column="2" Margin="{StaticResource AppWideMarginL}" Maximum="255" SmallChange="1" Style="{StaticResource AppSliderStyle}" Value="{Binding R, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" />
            <FrameworkElement Grid.Row="1" Margin="{StaticResource AppMarginT}" />
            <Label Content="G" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
            <TextBox Grid.Column="1" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding G, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
            <Slider Grid.Column="2" Grid.Row="2" Margin="{StaticResource AppWideMarginL}" Maximum="255" SmallChange="1" Style="{StaticResource AppSliderStyle}" Value="{Binding G, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" />
            <FrameworkElement Grid.Row="3" Margin="{StaticResource AppMarginT}" />
            <Label Content="B" Grid.Row="4" Style="{StaticResource AppTermLabelStyle}" />
            <TextBox Grid.Column="1" Grid.Row="4" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding B, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
            <Slider Grid.Column="2" Grid.Row="4" Margin="{StaticResource AppWideMarginL}" Maximum="255" SmallChange="1" Style="{StaticResource AppSliderStyle}" Value="{Binding B, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" />
            <FrameworkElement Grid.Row="5" Margin="{StaticResource AppMarginT}" />
            <Label Content="A" Grid.Row="6" Style="{StaticResource AppTermLabelStyle}" />
            <TextBox Grid.Column="1" Grid.Row="6" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding A, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
            <Slider Grid.Column="2" Grid.Row="6" Margin="{StaticResource AppWideMarginL}" Maximum="255" SmallChange="1" Style="{StaticResource AppSliderStyle}" Value="{Binding A, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Border Grid.Column="3" Grid.RowSpan="7" Margin="{StaticResource AppWideMarginLTB}" Name="border_color" SnapsToDevicePixels="True">
                <Rectangle Name="rectangle_color" />
            </Border>
        </Grid>
        <StackPanel HorizontalAlignment="Right" Margin="{StaticResource AppEdgeMarginT}" Orientation="Horizontal">
            <Button Content="OK" Style="{StaticResource AppConfirmButtonStyle}" Click="button_OK_Click" />
            <Button Content="キャンセル" Margin="{StaticResource AppConfirmMargin}" IsCancel="True" Style="{StaticResource AppConfirmButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
