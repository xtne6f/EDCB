<Window x:Class="EpgTimer.SetDefSearchSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:EpgTimer"
        Height="{StaticResource AppSetDefSearchSettingWindowHeight}" Style="{StaticResource AppWindowStyle}" Width="{StaticResource AppSearchWindowWidth}" Title="検索条件" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <my:SearchKeyView x:Name="searchKey" />
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="{StaticResource AppEdgeMargin}" Orientation="Horizontal">
            <Label Content="※このOKボタンではまだ設定は保存されません。" Style="{StaticResource AppLabelStyle}" />
            <Button Content="キャンセル" IsCancel="True" Margin="{StaticResource AppConfirmMargin}" Style="{StaticResource AppConfirmButtonStyle}" />
            <Button Content="OK" Margin="{StaticResource AppConfirmMargin}" Style="{StaticResource AppConfirmButtonStyle}" Click="button_OK_Click" />
        </StackPanel>
    </Grid>
</Window>
