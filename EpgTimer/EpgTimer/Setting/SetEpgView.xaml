<UserControl x:Class="EpgTimer.Setting.SetEpgView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EpgTimer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="780" d:DataContext="{d:DesignInstance local:Settings}" DataContextChanged="UserControl_DataContextChanged">
    <UserControl.Resources>
        <local:ToStringValueIsNotEqualConverter x:Key="notEqualConvert" />
        <local:ToStringValueIsOneOrZeroConverter x:Key="convert" />
        <local:ToStringValueIsZeroOrOneConverter x:Key="invert" />
    </UserControl.Resources>
    <TabControl>
        <TabItem Header="基本">
            <StackPanel Margin="{StaticResource AppEdgeMarginLTR}" Name="grid_basic" DataContextChanged="grid_basic_DataContextChanged">
                <StackPanel Orientation="Horizontal">
                    <Label Content="デザイン" Style="{StaticResource AppTermLabelStyle}" />
                    <UniformGrid Rows="1">
                        <RadioButton Checked="radioButton_basicDesign_Checked" Content="デフォルト" IsChecked="True" Name="radioButton_basicDesignDefault" Style="{StaticResource AppToggleButtonStyle}" />
                        <RadioButton Checked="radioButton_basicDesign_Checked" Content="サブ1" Name="radioButton_basicDesignSub1" Style="{StaticResource AppToggleButtonStyle}" />
                        <RadioButton Checked="radioButton_basicDesign_Checked" Content="サブ2" Name="radioButton_basicDesignSub2" Style="{StaticResource AppToggleButtonStyle}" />
                    </UniformGrid>
                    <Label Content="※デフォルトデザインの設定の一部は番組表以外にも影響します。" IsEnabled="{Binding IsChecked, ElementName=radioButton_basicDesignDefault}" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppLabelStyle}" />
                </StackPanel>
                <GroupBox Header="フォント" Margin="{StaticResource AppEdgeMarginT}">
                    <Grid Margin="{StaticResource AppMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="タイトル" Style="{StaticResource AppTermLabelStyle}" />
                        <Label Content="フォント" Grid.Column="1" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="2" IsEditable="True" Name="comboBox_fontTitle" Style="{StaticResource AppComboBoxStyle}" Text="{Binding FontNameTitle}" />
                        <Label Content="サイズ" Grid.Column="3" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                        <TextBox Grid.Column="4" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding FontSizeTitle}" />
                        <CheckBox Content="太字" Grid.Column="5" IsChecked="{Binding FontBoldTitle}" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppCheckBoxStyle}" />
                        <ComboBox Grid.Column="6" HorizontalAlignment="Left" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Name="comboBox_colorTitle_ref" SelectedIndex="8" Style="{StaticResource AppComboBoxStyle}" Visibility="Hidden" />
                        <ComboBox Grid.Column="6" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginLR}" Name="comboBox_colorTitle1" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_colorTitle_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Label Content="カスタム色" Grid.Column="7" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" Visibility="Hidden" />
                        <Button Grid.Column="7" Name="button_colorTitle1" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <FrameworkElement Grid.Row="1" Margin="{StaticResource AppMarginT}" />
                        <Label Content="タイトル以外" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                        <Label Content="フォント" Grid.Column="1" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="2" Grid.Row="2" IsEditable="True" Name="comboBox_font" Style="{StaticResource AppComboBoxStyle}" Text="{Binding FontName}" />
                        <Label Content="サイズ" Grid.Column="3" Grid.Row="2" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppTermLabelStyle}" />
                        <TextBox Grid.Column="4" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding FontSize}" />
                        <ComboBox Grid.Column="6" Grid.Row="2" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginLR}" Name="comboBox_colorTitle2" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_colorTitle_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="7" Grid.Row="2" Name="button_colorTitle2" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="表示" Margin="{StaticResource AppEdgeMarginT}">
                    <StackPanel Margin="{StaticResource AppMargin}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="マウス縦スクロールサイズ" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="1" InputMethod.IsInputMethodEnabled="False" IsEnabled="{Binding IsChecked, Converter={StaticResource invert}, ElementName=checkBox_mouseScrollAuto}" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding ScrollSize}" />
                            <CheckBox Content="自動" Grid.Column="2" IsChecked="{Binding MouseScrollAuto}" Margin="{StaticResource AppMarginL}" Name="checkBox_mouseScrollAuto" Style="{StaticResource AppCheckBoxStyle}" />
                            <FrameworkElement Grid.Row="1" Margin="{StaticResource AppMarginT}" />
                            <Label Content="マウス横スクロールサイズ" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="1" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" IsEnabled="{Binding IsChecked, Converter={StaticResource invert}, ElementName=checkBox_mouseHorizontalScrollAuto}" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding HorizontalScrollSize}" />
                            <CheckBox Content="自動" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Left" IsChecked="{Binding MouseHorizontalScrollAuto}" Margin="{StaticResource AppMarginL}" Name="checkBox_mouseHorizontalScrollAuto" Style="{StaticResource AppCheckBoxStyle}" />
                            <FrameworkElement Grid.Row="3" Margin="{StaticResource AppMarginT}" />
                            <Label Content="サービス１つの幅" Grid.Row="4" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="1" Grid.Row="4" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding ServiceWidth}" />
                            <Label Content="1分あたりの高さ" Grid.Column="3" Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="4" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding MinHeight}" />
                            <Label Content="ドラッグスクロール倍率" Grid.Column="3" Grid.Row="2" Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="4" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding DragScroll}" />
                            <Label Content="最低表示行数" Grid.Column="5" Grid.ColumnSpan="2" Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="7" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding MinimumHeight}" />
                            <Label Content="枠線の幅" Grid.Column="5" Grid.Row="2" Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="6" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" Margin="{StaticResource AppMarginR}" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding EpgBorderLeftSize}" />
                            <TextBox Grid.Column="7" Grid.Row="2" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding EpgBorderTopSize}" />
                        </Grid>
                        <DockPanel Margin="{StaticResource AppWideMarginT}">
                            <StackPanel DockPanel.Dock="Left">
                                <CheckBox Content="番組内容表示位置を番組名表示位置にあわせる" HorizontalAlignment="Left" IsChecked="{Binding EpgTitleIndent}" Style="{StaticResource AppCheckBoxStyle}" />
                                <CheckBox Content="詳細も表示" HorizontalAlignment="Left" IsChecked="{Binding EpgExtInfoTable}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                                <CheckBox Content="詳細をツールチップ表示する" HorizontalAlignment="Left" IsChecked="{Binding EpgToolTip}" Margin="{StaticResource AppMarginT}" Name="checkBox_descToolTip" Style="{StaticResource AppCheckBoxStyle}" />
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=checkBox_descToolTip, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource AppIndentMargin}">
                                    <CheckBox Content="番組名を表示しきれない物のみ表示" HorizontalAlignment="Left" IsChecked="{Binding EpgToolTipNoViewOnly}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                                    <StackPanel Margin="{StaticResource AppMarginT}" Orientation="Horizontal">
                                        <Label Content="ツールチップを表示するまでの時間(ミリ秒)" Style="{StaticResource AppTermLabelStyle}" />
                                        <TextBox InputMethod.IsInputMethodEnabled="False" Style="{StaticResource AppNarrowTextBoxStyle}" Text="{Binding EpgToolTipViewWait}" />
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Content="番組内容をポップアップ表示する" HorizontalAlignment="Left" IsChecked="{Binding EpgPopup}" Margin="{StaticResource AppMarginT}" Name="checkBox_epgPopup" Style="{StaticResource AppCheckBoxStyle}" />
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=checkBox_epgPopup, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource AppIndentMargin}" Orientation="Horizontal">
                                    <CheckBox Content="なるべく画面内に収める" IsChecked="{Binding EpgAdjustPopup}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                                    <CheckBox Content="詳細も表示" IsChecked="{Binding EpgExtInfoPopup}" Margin="{StaticResource AppMarginLT}" Style="{StaticResource AppCheckBoxStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="{StaticResource AppIndentMargin}">
                                <Label Content="タイトルの文字列置換リスト（/置換前/置換後/…）" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" />
                                <TextBox Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTextBoxStyle}" Text="{Binding EpgReplacePatternTitle}" />
                                <Label Content="タイトル以外の文字列置換リスト（〃）" Margin="{StaticResource AppMarginTB}" Style="{StaticResource AppLabelStyle}" />
                                <TextBox Margin="{StaticResource AppIndentMargin}" Style="{StaticResource AppTextBoxStyle}" Text="{Binding EpgReplacePattern}" />
                                <TextBlock Margin="{StaticResource AppMarginT}" />
                                <CheckBox Content="シングルクリックで予約ダイアログを開く" HorizontalAlignment="Left" Margin="{StaticResource AppMarginT}" IsChecked="{Binding EpgInfoSingleClick}" Style="{StaticResource AppCheckBoxStyle}" />
                                <CheckBox Content="番組詳細タブを選択した状態で予約ダイアログを開く" HorizontalAlignment="Left" Margin="{StaticResource AppMarginT}" IsChecked="{Binding EpgInfoOpenMode, Converter={StaticResource convert}}" Style="{StaticResource AppCheckBoxStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="{StaticResource AppWideMarginT}" Orientation="Horizontal">
                            <Label Content="グラデーション表示を行う" Style="{StaticResource AppTermLabelStyle}" />
                            <CheckBox Content="番組" IsChecked="{Binding EpgGradation}" Style="{StaticResource AppCheckBoxStyle}" />
                            <CheckBox Content="サービス・時刻軸" IsChecked="{Binding EpgGradationHeader}" Margin="{StaticResource AppMarginL}" Style="{StaticResource AppCheckBoxStyle}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </TabItem>
        <TabItem Header="色">
            <StackPanel Grid.IsSharedSizeScope="True" Margin="{StaticResource AppEdgeMarginLTR}" Name="grid_color" DataContextChanged="grid_color_DataContextChanged">
                <StackPanel Orientation="Horizontal">
                    <Label Content="デザイン" Style="{StaticResource AppTermLabelStyle}" />
                    <UniformGrid Rows="1">
                        <RadioButton Content="デフォルト" IsChecked="True" Name="radioButton_colorDesignDefault" Style="{StaticResource AppToggleButtonStyle}" Checked="radioButton_colorDesign_Checked" />
                        <RadioButton Content="サブ1" Name="radioButton_colorDesignSub1" Style="{StaticResource AppToggleButtonStyle}" Checked="radioButton_colorDesign_Checked" />
                        <RadioButton Content="サブ2" Name="radioButton_colorDesignSub2" Style="{StaticResource AppToggleButtonStyle}" Checked="radioButton_colorDesign_Checked" />
                    </UniformGrid>
                    <Label Content="※デフォルトデザインの設定の一部は番組表以外にも影響します。" IsEnabled="{Binding IsChecked, ElementName=radioButton_colorDesignDefault}" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppLabelStyle}" />
                </StackPanel>
                <GroupBox Header="ジャンル別背景色" Margin="{StaticResource AppWideMarginT}">
                    <Grid Margin="{StaticResource AppMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="column0" Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition SharedSizeGroup="column2" Width="Auto" />
                            <ColumnDefinition SharedSizeGroup="column3" Width="Auto" />
                            <ColumnDefinition SharedSizeGroup="column4" Width="Auto" />
                            <ColumnDefinition SharedSizeGroup="column5" Width="Auto" />
                            <ColumnDefinition SharedSizeGroup="column6" Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="カスタム色" Grid.Column="2" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" />
                        <FrameworkElement Grid.Column="3" Margin="{StaticResource AppIndentMargin}" />
                        <Label Content="カスタム色" Grid.Column="6" Margin="{StaticResource AppMarginB}" Style="{StaticResource AppLabelStyle}" />
                        <FrameworkElement Grid.Column="7" Margin="{StaticResource AppIndentMargin}" />
                        <Label Content="ニュース／報道" Grid.Row="1" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Name="comboBox_color_ref" SelectedIndex="8" Style="{StaticResource AppComboBoxStyle}" Visibility="Hidden" />
                        <ComboBox Grid.Column="1" Grid.Row="1" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox0" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="2" Grid.Row="1" Name="button0" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <Label Content="スポーツ" Grid.Column="4" Grid.Row="1" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="5" Grid.Row="1" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox1" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="6" Grid.Row="1" Name="button1" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <FrameworkElement Grid.Row="2" Margin="{StaticResource AppMarginT}" />
                        <Label Content="情報／ワイドショー" Grid.Row="3" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="1" Grid.Row="3" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox2" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="2" Grid.Row="3" Name="button2" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <Label Content="ドラマ" Grid.Column="4" Grid.Row="3" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="5" Grid.Row="3" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox3" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="6" Grid.Row="3" Name="button3" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <FrameworkElement Grid.Row="4" Margin="{StaticResource AppMarginT}" />
                        <Label Content="音楽" Grid.Row="5" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="1" Grid.Row="5" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox4" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="2" Grid.Row="5" Name="button4" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <Label Content="バラエティ" Grid.Column="4" Grid.Row="5" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="5" Grid.Row="5" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox5" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="6" Grid.Row="5" Name="button5" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <FrameworkElement Grid.Row="6" Margin="{StaticResource AppMarginT}" />
                        <Label Content="映画" Grid.Row="7" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="1" Grid.Row="7" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox6" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="2" Grid.Row="7" Name="button6" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <Label Content="アニメ／特撮" Grid.Column="4" Grid.Row="7" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="5" Grid.Row="7" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox7" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="6" Grid.Row="7" Name="button7" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <FrameworkElement Grid.Row="8" Margin="{StaticResource AppMarginT}" />
                        <Label Content="ドキュメンタリー／教養" Grid.Row="9" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="1" Grid.Row="9" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox8" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="2" Grid.Row="9" Name="button8" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <Label Content="劇場／公演" Grid.Column="4" Grid.Row="9" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="5" Grid.Row="9" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox9" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="6" Grid.Row="9" Name="button9" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <FrameworkElement Grid.Row="10" Margin="{StaticResource AppMarginT}" />
                        <Label Content="趣味／教育" Grid.Row="11" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="1" Grid.Row="11" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox10" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="2" Grid.Row="11" Name="button10" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <Label Content="福祉" Grid.Column="4" Grid.Row="11" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="5" Grid.Row="11" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox11" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="6" Grid.Row="11" Name="button11" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <FrameworkElement Grid.Row="12" Margin="{StaticResource AppMarginT}" />
                        <Label Content="その他" Grid.Row="13" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="1" Grid.Row="13" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox12" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="2" Grid.Row="13" Name="button12" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <Label Content="なし" Grid.Column="4" Grid.Row="13" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="5" Grid.Row="13" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox13" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="6" Grid.Row="13" Name="button13" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <FrameworkElement Grid.Row="14" Margin="{StaticResource AppMarginT}" />
                        <Label Content="サービス背景" Grid.Row="15" Style="{StaticResource AppTermLabelStyle}" />
                        <ComboBox Grid.Column="1" Grid.Row="15" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox_service" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                        <Button Grid.Column="2" Grid.Row="15" Name="button_service" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <Label Content="番組表背景 (A値は強調表示用)" Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="15" Style="{StaticResource AppTermLabelStyle}" />
                        <Button Grid.Column="6" Grid.Row="15" Name="button_epgBack" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        <Label Content="プリセット" Grid.Column="8" Grid.Row="11" Style="{StaticResource AppLabelStyle}" />
                        <Button Content="明色" Grid.Column="8" Grid.Row="13" Style="{StaticResource AppButtonStyle}" Click="button_setLightDefault_Click" />
                        <Button Content="暗色" Grid.Column="8" Grid.Row="15" Style="{StaticResource AppButtonStyle}" Click="button_setDarkDefault_Click" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="予約枠" Margin="{StaticResource AppWideMarginT}">
                    <StackPanel Margin="{StaticResource AppMargin}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="column0" Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="column2" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="column3" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="column4" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="column5" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="column6" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="通常" Style="{StaticResource AppTermLabelStyle}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox_reserveNormal" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                            <Button Grid.Column="2" Name="button14" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                            <Label Content="無効" Grid.Column="4" Style="{StaticResource AppTermLabelStyle}" />
                            <ComboBox Grid.Column="5" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox_reserveNo" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                            <Button Grid.Column="6" Name="button15" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                            <FrameworkElement Grid.Row="1" Margin="{StaticResource AppMarginT}" />
                            <Label Content="チューナー不足" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                            <ComboBox Grid.Column="1" Grid.Row="2" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox_reserveNoTuner" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                            <Button Grid.Column="2" Grid.Row="2" Name="button16" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                            <Label Content="一部実行" Grid.Column="4" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                            <ComboBox Grid.Column="5" Grid.Row="2" ItemsSource="{Binding Source={x:Static local:ColorDef.BrushNames}}" ItemTemplate="{StaticResource AppColorNameItemTemplate}" Margin="{StaticResource AppMarginR}" Name="comboBox_reserveWarning" Style="{StaticResource AppComboBoxStyle}" TextSearch.TextPath="Key" Width="{Binding ActualWidth, ElementName=comboBox_color_ref}" SelectionChanged="comboBox_color_SelectionChanged" />
                            <Button Grid.Column="6" Grid.Row="2" Name="button17" Style="{StaticResource AppButtonStyle}" Click="button_Color_Click" />
                        </Grid>
                        <Grid Margin="{StaticResource AppWideMarginT}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="塗りつぶしで表示 (不透明度)" Style="{StaticResource AppTermLabelStyle}" />
                            <Slider AutoToolTipPlacement="TopLeft" Grid.Column="1" LargeChange="10" Maximum="100" Minimum="0" SmallChange="1" Style="{StaticResource AppSliderStyle}" Value="{Binding ReserveRectFillOpacity}" />
                            <CheckBox Content="影付きで塗りつぶす" Grid.Column="2" IsChecked="{Binding ReserveRectFillWithShadow}" Margin="{StaticResource AppWideMarginL}" Style="{StaticResource AppCheckBoxStyle}" />
                        </Grid>
                        <CheckBox Content="時刻軸に線を引く" HorizontalAlignment="Left" IsChecked="{Binding ReserveRectShowMarker}" Margin="{StaticResource AppWideMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </TabItem>
        <TabItem Header="表示項目">
            <Grid Margin="{StaticResource AppEdgeMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <RadioButton Content="デフォルト表示" HorizontalAlignment="Left" IsChecked="{Binding IsChecked, ElementName=radioButton_1_cust, Converter={StaticResource invert}}" Style="{StaticResource AppRadioButtonStyle}" />
                    <RadioButton Content="カスタマイズ表示" HorizontalAlignment="Left" IsChecked="{Binding UseCustomEpgView}" Margin="{StaticResource AppMarginT}" Name="radioButton_1_cust" Style="{StaticResource AppRadioButtonStyle}" />
                </StackPanel>
                <Grid Grid.Row="1" IsEnabled="{Binding IsChecked, ElementName=radioButton_1_cust}" Margin="{StaticResource AppIndentMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Label Content="表示タブ" Margin="{StaticResource AppMarginTB}" Style="{StaticResource AppLabelStyle}" />
                    <ListBox Grid.Row="1" Name="listBox_tab" />
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="{StaticResource AppMarginL}">
                        <Button Content="追加" Style="{StaticResource AppButtonStyle}" Click="button_tab_add_Click" />
                        <Button Content="変更" IsEnabled="{Binding SelectedIndex, ElementName=listBox_tab, Converter={StaticResource notEqualConvert}, ConverterParameter=-1}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_tab_chg_Click" />
                        <Button Content="削除" IsEnabled="{Binding SelectedIndex, ElementName=listBox_tab, Converter={StaticResource notEqualConvert}, ConverterParameter=-1}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_tab_del_Click" />
                        <Button Content="↑" IsEnabled="{Binding SelectedIndex, ElementName=listBox_tab, Converter={StaticResource notEqualConvert}, ConverterParameter=-1}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="button_tab_up_Click" />
                        <Button Content="↓" IsEnabled="{Binding SelectedIndex, ElementName=listBox_tab, Converter={StaticResource notEqualConvert}, ConverterParameter=-1}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppButtonStyle}" Click="buttontab_down_Click" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock Margin="{StaticResource AppMarginT}" />
                    <CheckBox Content="標準モードのすべてのタブを同期スクロールする" HorizontalAlignment="Left" IsChecked="{Binding SynchronizeEpgScroll}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                    <CheckBox Content="サービス・日付を左クリックで表示モードを切り替える" HorizontalAlignment="Left" IsChecked="{Binding ToggleEpgModeOnHeaderLeftClick}" Margin="{StaticResource AppMarginT}" Style="{StaticResource AppCheckBoxStyle}" />
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
