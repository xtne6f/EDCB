<Window x:Class="EpgTimer.ChgReserveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:EpgTimer"
        SizeToContent="Height" Style="{StaticResource AppWindowStyle}" Title="プログラム予約追加" Width="{StaticResource AppRecSettingWindowWidth}" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Name="tabControl" TabStripPlacement="Bottom">
            <TabItem Header="予約">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource AppEdgeMarginLTR}">
                        <CheckBox Content="プログラム予約化（一度プログラム予約化したものは元に戻せません。番組を特定できなくなるため追従もできません。）" HorizontalAlignment="Left" IsChecked="True" IsEnabled="False" Name="checkBox_program" Style="{StaticResource AppCheckBoxStyle}" Click="checkBox_program_Click" />
                        <Grid Margin="{StaticResource AppWideMarginT}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="サービス" Style="{StaticResource AppTermLabelStyle}" />
                            <ComboBox Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=checkBox_program}" Margin="{StaticResource AppWideMarginR}" Name="comboBox_service" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=stackPanel_start}" />
                            <Label Content="番組名" Grid.Column="2" Style="{StaticResource AppTermLabelStyle}" />
                            <TextBox Grid.Column="3" IsEnabled="{Binding IsChecked, ElementName=checkBox_program}" Name="textBox_title" Style="{StaticResource AppTextBoxStyle}" />
                            <FrameworkElement Grid.Row="1" Margin="{StaticResource AppMarginT}" />
                            <Label Content="開始日時" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                            <DatePicker Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" Name="datePicker_ref" SelectedDate="2000/12/30" Visibility="Hidden" />
                            <ComboBox Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" Name="comboBox_hms_ref" SelectedIndex="0" Style="{StaticResource AppComboBoxStyle}" Visibility="Hidden">
                                <ComboBoxItem Content="88" />
                            </ComboBox>
                            <StackPanel Grid.Column="1" Grid.Row="2" IsEnabled="{Binding IsChecked, ElementName=checkBox_program}" Margin="{StaticResource AppWideMarginR}" Name="stackPanel_start" Orientation="Horizontal">
                                <DatePicker Name="datePicker_start" Width="{Binding ActualWidth, ElementName=datePicker_ref}" />
                                <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_sh" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                                <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_sm" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                                <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_ss" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                            </StackPanel>
                            <Label Content="終了日時" Grid.Column="2" Grid.Row="2" Style="{StaticResource AppTermLabelStyle}" />
                            <StackPanel Grid.Column="3" Grid.Row="2" IsEnabled="{Binding IsChecked, ElementName=checkBox_program}" Orientation="Horizontal">
                                <DatePicker Name="datePicker_end" Width="{Binding ActualWidth, ElementName=datePicker_ref}" />
                                <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_eh" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                                <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_em" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                                <ComboBox Margin="{StaticResource AppMarginL}" Name="comboBox_es" Style="{StaticResource AppComboBoxStyle}" Width="{Binding ActualWidth, ElementName=comboBox_hms_ref}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <my:RecSettingView Margin="{StaticResource AppWideMarginT}" x:Name="recSettingView" />
                </DockPanel>
            </TabItem>
            <TabItem Header="番組詳細">
                <RichTextBox IsReadOnly="True" IsReadOnlyCaretVisible="True" Name="richTextBox_descInfo" Style="{StaticResource AppRichTextBoxStyle}" VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Margin="{StaticResource AppEdgeMargin}" Orientation="Horizontal">
            <Button Content="予約" Margin="{StaticResource AppConfirmMargin}" Name="button_chg_reserve" Style="{StaticResource AppConfirmButtonStyle}" ToolTip="Ctrl + S" Click="button_chg_reserve_Click" />
            <Button Content="削除" Margin="{StaticResource AppConfirmMargin}" Name="button_del_reserve" Style="{StaticResource AppConfirmButtonStyle}" ToolTip="Ctrl + D" Visibility="Hidden" Click="button_del_reserve_Click" />
            <Button Content="キャンセル" Margin="{StaticResource AppConfirmMargin}" Style="{StaticResource AppConfirmButtonStyle}" Click="button_cancel_Click" />
            <Button Content="番組情報を保存" IsEnabled="False" Margin="{StaticResource AppWideConfirmMargin}" Name="button_save_program" Style="{StaticResource AppConfirmButtonStyle}" Click="button_save_program_Click" />
        </StackPanel>
    </Grid>
</Window>
