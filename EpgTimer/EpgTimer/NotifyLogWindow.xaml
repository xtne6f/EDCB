<Window x:Class="EpgTimer.NotifyLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FocusManager.FocusedElement="{Binding ElementName=listView_log}" Height="{StaticResource AppNotifyLogWindowHeight}" Style="{StaticResource AppWindowStyle}" Title="情報通知ログ" Width="{StaticResource AppNotifyLogWindowWidth}" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <DockPanel Margin="{StaticResource AppEdgeMargin}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="クリア" Style="{StaticResource AppConfirmButtonStyle}" Click="button_clear_Click" />
            <Button Content="ファイルに保存する" Margin="{StaticResource AppConfirmMargin}" Style="{StaticResource AppConfirmButtonStyle}" Click="button_save_Click" />
            <Label Content="表示行数" IsEnabled="{Binding IsEnabled, ElementName=textBox_logMax, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource AppConfirmMargin}" Style="{StaticResource AppTermLabelStyle}" />
            <TextBox InputMethod.IsInputMethodEnabled="False" Name="textBox_logMax" Style="{StaticResource AppNarrowTextBoxStyle}" TextChanged="textBox_logMax_TextChanged" />
        </StackPanel>
        <ListView Margin="{StaticResource AppMarginT}" Name="listView_log" SelectionMode="Extended" GridViewColumnHeader.Click="GridViewColumnHeader_Click">
            <ListView.View>
                <GridView x:Name="gridView_log">
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Time}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="日時" HorizontalContentAlignment="Left"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Title}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="種別" HorizontalContentAlignment="Left"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=LogText}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="内容" HorizontalContentAlignment="Left"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
